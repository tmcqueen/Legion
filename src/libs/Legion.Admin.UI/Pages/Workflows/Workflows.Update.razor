@page "/workflows/{Id:guid}/edit"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject WorkflowStore WorkflowStore
@inject NavigationManager Nav

<PageTitle>Edit Workflow</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Edit Workflow</RadzenText>

<RadzenCard Style="max-width: 700px">
    <EditForm Model="@form" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="Name" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenTextBox Name="Name" @bind-Value="form.Name" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="Name" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="Description" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenTextArea Name="Description" @bind-Value="form.Description" Rows="3" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="Description" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="Content" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenTextArea Name="Content" @bind-Value="form.Content" Rows="10" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="Content" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Save" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/workflows"))" />
                </RadzenStack>
            </RadzenRow>
        </RadzenStack>
    </EditForm>
</RadzenCard>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly FormModel form = new();

    protected override async Task OnInitializedAsync()
    {
        var workflow = await WorkflowStore.GetAsync(Id);
        if (workflow is null) { Nav.NavigateTo("/workflows"); return; }
        form.Name = workflow.Name;
        form.Description = workflow.Description;
        form.Content = workflow.Content;
    }

    private async Task HandleSubmit()
    {
        var workflow = new WorkflowOptions
        {
            Id = Id,
            Name = form.Name,
            Description = form.Description,
            Content = form.Content,
        };
        await WorkflowStore.UpdateAsync(workflow);
        Nav.NavigateTo("/workflows");
    }

    private sealed class FormModel
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? Content { get; set; }
    }
}
