@page "/providers/{Id:guid}/delete"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject ProviderStore ProviderStore
@inject NavigationManager Nav

<PageTitle>Delete Provider</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Delete Provider</RadzenText>

@if (provider is not null)
{
    <RadzenCard Style="max-width: 500px">
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
            Are you sure you want to delete this provider? This action cannot be undone.
        </RadzenAlert>

        <RadzenStack Gap="4px" class="rz-mb-4">
            <RadzenText><strong>Name:</strong> @provider.Name</RadzenText>
            <RadzenText><strong>API URL:</strong> @provider.ApiUrl</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="HandleDelete" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/providers"))" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProviderOptions? provider;

    protected override async Task OnInitializedAsync()
    {
        provider = await ProviderStore.GetAsync(Id);
        if (provider is null) Nav.NavigateTo("/providers");
    }

    private async Task HandleDelete()
    {
        await ProviderStore.DeleteAsync(Id);
        Nav.NavigateTo("/providers");
    }
}
