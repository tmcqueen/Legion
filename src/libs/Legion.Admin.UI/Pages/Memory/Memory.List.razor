@page "/memory"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject MemoryStore MemoryStore
@inject NavigationManager Nav

<PageTitle>Memory Configurations</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Memory Configurations</RadzenText>

<RadzenDataGrid Data="@memories" TItem="MemoryOptions" AllowSorting="true" AllowPaging="true" PageSize="20">
    <Columns>
        <RadzenDataGridColumn TItem="MemoryOptions" Property="Id" Title="ID" Width="60px" />
        <RadzenDataGridColumn TItem="MemoryOptions" Property="AgentId" Title="Agent ID" Width="90px" />
        <RadzenDataGridColumn TItem="MemoryOptions" Property="SearchTime" Title="Search Time" />
        <RadzenDataGridColumn TItem="MemoryOptions" Property="MaxResults" Title="Max Results" Width="100px" />
        <RadzenDataGridColumn TItem="MemoryOptions" Property="FunctionToolName" Title="Function Tool" />
        <RadzenDataGridColumn TItem="MemoryOptions" Title="" Width="140px" Sortable="false">
            <Template Context="memory">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => Nav.NavigateTo($"/agents/{memory.AgentId}/edit"))" class="rz-mr-1" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                              Click="@(() => Nav.NavigateTo($"/memory/{memory.Id}/delete"))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<MemoryOptions> memories = [];

    protected override async Task OnInitializedAsync()
    {
        memories = await MemoryStore.GetAllAsync();
    }
}
