@inject DialogService DialogService

<RadzenStack Gap="1rem" style="min-width: 320px; padding: 1rem;">
    <EditForm Model="@form" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <RadzenStack Gap="0.5rem">
            <RadzenRow>
                <RadzenColumn Size="4" class="rz-text-align-end">
                    <RadzenLabel Text="Key" />
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenTextBox Name="Key" @bind-Value="form.Key" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="Key" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" class="rz-text-align-end">
                    <RadzenLabel Text="Value" />
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-1">
                        <RadzenToggleButton Text="@(headerValueSecretMode ? "Secret" : "Raw")"
                                            Icon="@(headerValueSecretMode ? "lock" : "lock_open")"
                                            Value="@headerValueSecretMode"
                                            Change="@(v => { headerValueSecretMode = v; form.Value = null; })"
                                            ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
                    </RadzenStack>
                    @if (headerValueSecretMode)
                    {
                        <RadzenTextBox Name="Value" @bind-Value="form.Value"
                                       Placeholder="secret://headers/my-key"
                                       style="width: 100%;" />
                    }
                    else
                    {
                        <RadzenTextBox Name="Value" @bind-Value="form.Value" style="width: 100%;" />
                    }
                    <RadzenDataAnnotationValidator Component="Value" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Save" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="Cancel" />
                </RadzenStack>
            </RadzenRow>
        </RadzenStack>
    </EditForm>
</RadzenStack>

@code {
    [Parameter] public string? InitialKey { get; set; }
    [Parameter] public string? InitialValue { get; set; }

    private readonly FormModel form = new();
    private bool headerValueSecretMode;

    protected override void OnInitialized()
    {
        form.Key = InitialKey;
        form.Value = InitialValue;
        headerValueSecretMode = InitialValue?.StartsWith("secret://") == true;
    }

    private void Submit() => DialogService.Close(form);
    private void Cancel() => DialogService.Close(null);

    public sealed class FormModel
    {
        public string? Key { get; set; }
        public string? Value { get; set; }
    }
}
