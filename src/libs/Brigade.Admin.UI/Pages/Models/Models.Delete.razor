@page "/models/{Id:int}/delete"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject ModelStore ModelStore
@inject NavigationManager Nav

<PageTitle>Delete Model</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Delete Model</RadzenText>

@if (model is not null)
{
    <RadzenCard Style="max-width: 500px">
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
            Are you sure you want to delete this model? This action cannot be undone.
        </RadzenAlert>

        <RadzenStack Gap="4px" class="rz-mb-4">
            <RadzenText><strong>Name:</strong> @model.Name</RadzenText>
            <RadzenText><strong>Display Name:</strong> @model.DisplayName</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="HandleDelete" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/models"))" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public int Id { get; set; }

    private ModelOptions? model;

    protected override async Task OnInitializedAsync()
    {
        model = await ModelStore.GetAsync(Id);
        if (model is null) Nav.NavigateTo("/models");
    }

    private async Task HandleDelete()
    {
        await ModelStore.DeleteAsync(Id);
        Nav.NavigateTo("/models");
    }
}
