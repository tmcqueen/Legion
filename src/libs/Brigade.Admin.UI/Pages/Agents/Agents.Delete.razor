@page "/agents/{Id:guid}/delete"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject AgentStore AgentStore
@inject NavigationManager Nav

<PageTitle>Delete Agent</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Delete Agent</RadzenText>

@if (agent is not null)
{
    <RadzenCard Style="max-width: 500px">
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
            Are you sure you want to delete this agent? This action cannot be undone.
        </RadzenAlert>

        <RadzenStack Gap="4px" class="rz-mb-4">
            <RadzenText><strong>Name:</strong> @agent.Name</RadzenText>
            <RadzenText><strong>Provider:</strong> @(agent.Provider?.Name ?? $"ID {agent.ProviderId}")</RadzenText>
            <RadzenText><strong>Tools:</strong> @agent.Tools.Count</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="HandleDelete" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/agents"))" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AgentOptions? agent;

    protected override async Task OnInitializedAsync()
    {
        agent = await AgentStore.GetAsync(Id);
        if (agent is null) Nav.NavigateTo("/agents");
    }

    private async Task HandleDelete()
    {
        await AgentStore.DeleteAsync(Id);
        Nav.NavigateTo("/agents");
    }
}
