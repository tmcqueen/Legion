@page "/tools/{Id:int}/delete"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject ToolStore ToolStore
@inject NavigationManager Nav

<PageTitle>Delete Tool</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Delete Tool</RadzenText>

@if (tool is not null)
{
    <RadzenCard Style="max-width: 500px">
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
            Are you sure you want to delete this tool? This action cannot be undone.
        </RadzenAlert>

        <RadzenStack Gap="4px" class="rz-mb-4">
            <RadzenText><strong>Name:</strong> @tool.Name</RadzenText>
            <RadzenText><strong>Description:</strong> @tool.Description</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="HandleDelete" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/tools"))" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public int Id { get; set; }

    private ToolOptions? tool;

    protected override async Task OnInitializedAsync()
    {
        tool = await ToolStore.GetAsync(Id);
        if (tool is null) Nav.NavigateTo("/tools");
    }

    private async Task HandleDelete()
    {
        await ToolStore.DeleteAsync(Id);
        Nav.NavigateTo("/tools");
    }
}
