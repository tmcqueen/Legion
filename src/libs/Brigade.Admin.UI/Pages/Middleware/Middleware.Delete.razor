@page "/middleware/{Id:int}/delete"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject MiddlewareStore MiddlewareStore
@inject NavigationManager Nav

<PageTitle>Delete Middleware</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Delete Middleware</RadzenText>

@if (middleware is not null)
{
    <RadzenCard Style="max-width: 500px">
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
            Are you sure you want to delete this middleware? This action cannot be undone.
        </RadzenAlert>

        <RadzenStack Gap="4px" class="rz-mb-4">
            <RadzenText><strong>Name:</strong> @middleware.Name</RadzenText>
            <RadzenText><strong>Scope:</strong> @middleware.Scope</RadzenText>
            <RadzenText><strong>Type:</strong> @middleware.Type</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="HandleDelete" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/middleware"))" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public int Id { get; set; }

    private MiddlewareOptions? middleware;

    protected override async Task OnInitializedAsync()
    {
        middleware = await MiddlewareStore.GetAsync(Id);
        if (middleware is null) Nav.NavigateTo("/middleware");
    }

    private async Task HandleDelete()
    {
        await MiddlewareStore.DeleteAsync(Id);
        Nav.NavigateTo("/middleware");
    }
}
