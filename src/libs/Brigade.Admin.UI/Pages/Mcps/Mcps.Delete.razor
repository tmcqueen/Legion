@page "/mcps/{Id:int}/delete"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject McpStore McpStore
@inject NavigationManager Nav

<PageTitle>Delete MCP Server</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Delete MCP Server</RadzenText>

@if (mcp is not null)
{
    <RadzenCard Style="max-width: 500px">
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
            Are you sure you want to delete this MCP server? This action cannot be undone.
        </RadzenAlert>

        <RadzenStack Gap="4px" class="rz-mb-4">
            <RadzenText><strong>Name:</strong> @mcp.Name</RadzenText>
            <RadzenText><strong>Label:</strong> @mcp.ServerLabel</RadzenText>
            <RadzenText><strong>URL:</strong> @mcp.ServerUrl</RadzenText>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Delete" Click="HandleDelete" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/mcps"))" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter] public int Id { get; set; }

    private McpServerOptions? mcp;

    protected override async Task OnInitializedAsync()
    {
        mcp = await McpStore.GetAsync(Id);
        if (mcp is null) Nav.NavigateTo("/mcps");
    }

    private async Task HandleDelete()
    {
        await McpStore.DeleteAsync(Id);
        Nav.NavigateTo("/mcps");
    }
}
