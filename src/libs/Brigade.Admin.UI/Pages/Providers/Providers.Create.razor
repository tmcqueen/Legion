@page "/providers/create"
@layout MainLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject ProviderStore ProviderStore
@inject ModelStore ModelStore
@inject NavigationManager Nav

<PageTitle>Create Provider</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-4">Create Provider</RadzenText>

<RadzenCard Style="max-width: 700px">
    <EditForm Model="@form" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="Name" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenTextBox Name="Name" @bind-Value="form.Name" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="Name" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="API URL" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenTextBox Name="ApiUrl" @bind-Value="form.ApiUrl" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="ApiUrl" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="API Token" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenPassword Name="ApiToken" @bind-Value="form.ApiToken" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="ApiToken" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="4" SizeMD="4" class="rz-text-align-start rz-text-align-md-end">
                    <RadzenLabel Text="Models" />
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="8" Style="display: block; width: 100%;">
                    <RadzenDropDown Name="Models" @bind-Value="selectedModelIds" Multiple="true"
                                    Data="allModels" TextProperty="DisplayName" ValueProperty="Id"
                                    Placeholder="Select models…" style="width: 100%;" />
                    <RadzenDataAnnotationValidator Component="Models" Style="position: absolute" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow JustifyContent="JustifyContent.End">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Create" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => Nav.NavigateTo("/providers"))" />
                </RadzenStack>
            </RadzenRow>
        </RadzenStack>
    </EditForm>
</RadzenCard>

@code {
    private readonly FormModel form = new();
    private List<ModelOptions> allModels = [];
    private IEnumerable<int> selectedModelIds = [];

    protected override async Task OnInitializedAsync()
    {
        allModels = await ModelStore.GetAllAsync();
    }

    private async Task HandleSubmit()
    {
        var provider = new ProviderOptions
        {
            Name = form.Name,
            ApiUrl = form.ApiUrl,
            ApiToken = form.ApiToken,
        };
        var saved = await ProviderStore.AddAsync(provider);
        if (selectedModelIds.Any())
            await ProviderStore.AssignModelsAsync(saved.Id, selectedModelIds);
        Nav.NavigateTo("/providers");
    }

    private sealed class FormModel
    {
        public string? Name { get; set; }
        public string? ApiUrl { get; set; }
        public string? ApiToken { get; set; }
    }
}
