@inject NavigationManager Navigation


<Router 
    AppAssembly="typeof(Program).Assembly" 
    AdditionalAssemblies="[
        typeof(Legion.Admin.UI.Pages.Login).Assembly
    ]"
    NotFoundPage="typeof(Legion.Admin.UI.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Legion.Admin.UI.Layouts.MainLayout)">
            <NotAuthorized>
                @{ Navigation.NavigateTo("/account/login", forceLoad: true); }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>